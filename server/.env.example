# Optional: legacy desktop space registration only; accounts are open without it.
# Generate a private value if needed: openssl rand -base64 48
PICKUP_REGISTRATION_TOKEN=
PICKUP_ACCOUNT_QUOTA_BYTES=20971520
# Exact socket peer IPs permitted to supply X-Real-IP (empty = never trust headers).
PICKUP_TRUSTED_PROXIES=
PICKUP_ALLOWED_ORIGINS=https://localhost,capacitor://localhost
PICKUP_PORT=8787
# Required only for: docker compose --profile https up -d
PICKUP_DOMAIN=sync.example.com
